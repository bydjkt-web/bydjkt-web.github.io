rules_version = '2';

// Koleksi "leads": pengunjung website HANYA boleh membuat dokumen baru (create).
// Tidak ada yang bisa membaca, mengubah, atau menghapus dari browser.
// Lead dibaca lewat Firebase Console / Admin SDK / dashboard internal Anda (Drive Desk) dengan login.
service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{leadId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'name','phone','model','timeline','payment','testDrive','tradeIn',
          'score','tier','page','first_page','referrer','utm_source','utm_medium','utm_campaign','utm_term','createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^628[0-9]{8,12}$')
        && request.resource.data.model is string && request.resource.data.model.size() <= 60
        && request.resource.data.timeline in ['minggu','bulan','tiga_bulan','info']
        && request.resource.data.payment in ['cash','kredit','belum']
        && request.resource.data.testDrive is bool
        && request.resource.data.tradeIn is bool
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.tier in ['hot','warm','cold']
        && request.resource.data.page is string && request.resource.data.page.size() <= 200
        && (!('first_page' in request.resource.data) || (request.resource.data.first_page is string && request.resource.data.first_page.size() <= 200))
        && request.resource.data.createdAt == request.time;
    }

    // semua yang lain ditutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
